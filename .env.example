# Server Port
PORT=5000

# PostgreSQL Connection String (e.g. Neon, Supabase, AWS RDS, Render Postgres)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# JWT Secret for Session Authentication & RBAC
JWT_SECRET="your-super-secret-jwt-key"

# Environment Mode (production / development)
NODE_ENV=production

# (Optional: Only if frontend & backend are deployed on different domains)
# VITE_API_URL="https://your-backend-app.onrender.com"
# VITE_WS_URL="https://your-backend-app.onrender.com"
